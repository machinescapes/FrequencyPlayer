{
    "name": "frequency",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.23.0",
    "scripts": {
        "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
        "test": "node --test test/*.test.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint app server.ts scripts test eslint.config.js",
        "check": "pnpm run typecheck && pnpm run lint && pnpm test",
        "build": "pnpm run check && node scripts/build.mjs",
        "sync:epg": "node scripts/sync-epg.mjs",
        "sync:tv": "node scripts/sync-tv.mjs"
    },
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "hls.js": "^1.7.4",
        "remix": "3.3.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "fake-indexeddb": "^6.2.8",
        "fast-xml-parser": "^5.12.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
