{
    "name": "frequency",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.9.1",
    "scripts": {
        "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
        "test": "node --test test/*.test.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint app server.ts scripts test eslint.config.js",
        "check": "pnpm run typecheck && pnpm run lint && pnpm test",
        "build": "pnpm run check && node scripts/build.mjs",
        "sync:iptv": "node scripts/sync-iptv.mjs",
        "sync:epg": "node scripts/sync-epg.mjs"
    },
    "engines": {
        "node": ">=24.3.0"
    },
    "dependencies": {
        "hls.js": "^1.7.3",
        "remix": "3.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "fake-indexeddb": "^6.2.6",
        "fast-xml-parser": "^5.11.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
