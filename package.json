{
    "name": "frequency",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
        "test": "node --test test/*.test.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint app server.ts scripts test eslint.config.js",
        "check": "npm run typecheck && npm run lint && npm test",
        "build": "npm run check && node scripts/build.mjs"
    },
    "engines": {
        "node": ">=24.3.0"
    },
    "dependencies": {
        "hls.js": "^1.7.3",
        "remix": "3.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
